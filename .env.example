# ============================================
# Supabase Configuration (Required)
# ============================================
# Get these values from your Supabase project dashboard at https://supabase.com/dashboard

NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# ============================================
# ML Service Configuration (Required)
# ============================================
NEXT_PUBLIC_ML_SERVICE_URL="http://localhost:8000"

# ============================================
# Autonomous System Configuration (Required)
# ============================================
# Generate a secure random string for cron job authentication
# Example: openssl rand -base64 32
CRON_SECRET="your_secure_cron_secret_here"

# ============================================
# Google AI / Gemini Configuration (Optional - for LLM agents)
# ============================================
# Get free API key from: https://aistudio.google.com/app/apikey
# Free tier: 1500 requests/day, perfect for autonomous agents
GOOGLE_AI_API_KEY="AIzaSy..."

# ============================================
# Slack Integration (Optional - for autonomous alerts)
# ============================================
# Get webhook URL from: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/YOUR/WEBHOOK/URL"

# ============================================
# Email Integration (Optional - for autonomous alerts)
# ============================================
# Sign up at: https://resend.com (Free tier: 100 emails/day)
# For testing, use "onboarding@resend.dev" as EMAIL_FROM
# For production, verify your domain at https://resend.com/domains
RESEND_API_KEY="re_your_api_key_here"
EMAIL_FROM="onboarding@resend.dev"              # Use this for testing (no verification needed)
# EMAIL_FROM="simops@yourdomain.com"            # For production (requires domain verification)
EMAIL_FROM_NAME="SIM-OPS Agent Alerts"
EMAIL_TO="your.email@example.com"               # Where to send alerts
ACCOUNT_MANAGER_EMAIL="retention@yourdomain.com"
EXECUTIVE_EMAIL="executives@yourdomain.com"

# ============================================
# Jira Integration (Optional - for ticket creation)
# ============================================
# Get API token from: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_URL="https://your-domain.atlassian.net"
JIRA_EMAIL="your.email@company.com"
JIRA_API_TOKEN="your_jira_api_token_here"

# ============================================
# Twilio Voice Call Integration (Optional - for critical alerts)
# ============================================
# Sign up at: https://www.twilio.com/ (Free trial: $15 credit)
# Get credentials from: https://console.twilio.com/
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your_auth_token_here"
TWILIO_PHONE_NUMBER="+1234567890"

# Phone numbers to call for critical alerts (E.164 format: +1234567890)
ALERT_PHONE_NUMBER="+1234567890"           # Primary alert recipient
ACCOUNT_MANAGER_PHONE="+1234567890"        # For churn alerts
OPS_PHONE_NUMBER="+1234567890"             # For anomaly alerts

# Voice call thresholds (aggregate-based, demo-friendly)
# Voice calls are triggered when ANY of these thresholds are exceeded:
VOICE_CALL_THRESHOLD_COUNT="5"             # Trigger if 5+ customers at high risk (>75% churn)
VOICE_CALL_THRESHOLD_CHURN="0.65"          # Trigger if average churn rate >65%
VOICE_CALL_THRESHOLD_PERCENTAGE="0.15"     # Trigger if >15% of customers are high risk

# Your app URL (required for Twilio webhooks)
NEXT_PUBLIC_APP_URL="http://localhost:3000"  # Local dev
# NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"  # Production

# Test API secret (for testing voice calls)
TEST_API_SECRET="test-secret-123"

# ============================================
# AWS Configuration (Optional - Free Tier)
# ============================================
# Create an IAM user with S3, SNS, SES, CloudWatch access
# Free tier: S3 (5GB), SNS (1M publishes), SES (3K emails), CloudWatch (5GB logs)
AWS_ACCESS_KEY_ID="your-access-key"
AWS_SECRET_ACCESS_KEY="your-secret-key"
AWS_REGION="ap-south-1"
AWS_S3_BUCKET="simops-reports"
AWS_SNS_TOPIC_ARN="arn:aws:sns:ap-south-1:123456789:simops-alerts"
AWS_SES_FROM_EMAIL="simops@yourdomain.com"
AWS_CLOUDWATCH_LOG_GROUP="/simops/app"
