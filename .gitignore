# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files - NEVER commit these!
.env
.env.local
.env.development
.env.production
.env.test
.env*.local
*.env
# EXCEPTION: Template files are safe to commit
!.env.example
!.env.local.template

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Python
ml-service/.venv
ml-service/venv
ml-service/venv_fresh
ml-service/__pycache__
ml-service/**/__pycache__
*.pyc
*.pyo
*.pyd
__pycache__/

# Sensitive files - NEVER commit these!
*.pem
*.key
*.cert
*.p12
*.pfx
secrets.json
credentials.json
service-account.json
.secrets/
config/secrets/

# Database files
*.db
*.sqlite
*.sqlite3
local_database.db

# Backup files that may contain sensitive data
*.backup
*.bak
*.sql.gz
*.dump

# IDE files that may contain sensitive data
.vscode/settings.json
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Logs that may contain sensitive data
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Test files with real credentials
test-with-real-data.js
test-production.js

# Temporary directories
tmp/
scratch/
temp/

# LaTeX build artifacts
*.aux
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz